{
  "uid": "spacenorm-cctv-config",
  "title": "spacenorm_obj_detection / CCTV Configuration",
  "tags": ["spacenorm_obj_detection"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": { "from": "now-5m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "CCTV configuration -- all sites, both static and dynamic method",
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "spacenorm_camera_info * on(camera) group_left() spacenorm_camera_connected",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "Value": "connected"
            },
            "indexByName": {
              "user_group_index": 0,
              "vision_node_id": 1,
              "camera": 2,
              "connected": 3,
              "company_name": 4,
              "config_method": 5,
              "device_id": 6,
              "monitor_id": 7,
              "mqtt_broker_addr": 8,
              "mqtt_broker_port": 9,
              "min_obj_size_ratio": 10,
              "has_roi": 11
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              { "field": "user_group_index" },
              { "field": "vision_node_id" },
              { "field": "camera" }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "camera" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open per-camera dashboard",
                    "url": "/d/spacenorm-per-camera?var-camera=${__data.fields.camera}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "connected" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
                ]
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          }
        ]
      },
      "description": "Backed by spacenorm_camera_info joined with spacenorm_camera_connected on the camera label (PromQL: info * on(camera) group_left() connected -- verified live that this keeps info's full label set with connected's 0/1 as the resulting value, rather than a Grafana frontend join transform, which cannot be tested without a browser). Sorted by user_group_index -> vision_node_id -> camera to read as the user_groups -> vision_nodes -> CCTVs hierarchy defined in each site's overrides json file (static-method cameras have no user_group/vision_node, so they sort first with blank values). user_group_index/vision_node_id are string labels, so sort order is lexicographic, not numeric -- fine at this project's single-digit scale, worth revisiting if group/node counts grow past 9. Credentials and raw RTSP URIs are deliberately never in these metrics (see docs/prometheus_grafana_monitoring_plan.md §2). Click a camera to open its per-camera dashboard (reconnect rate, last-frame age, detection history, live snapshot)."
    }
  ]
}
