
==================================================================================================================
[ Spot Instance 생성하기 ]
create_instance.sh <g5.xlarge|g5.12xlarge>

[ Spot Instance 로 생성되었는지 확인하기 ]
aws ec2 describe-instances \
  --instance-id i-0310003473093a305 \
  --query "Reservations[*].Instances[*].[InstanceId,InstanceLifecycle]"

--> 리턴 값에 "spot"이 포함되어야 함


-- 아래는 EBS 볼륨 생성 및 마운트 관련 명령어들로서, 테스트해 보아야 함. --
[ EBS 볼륨 생성하기 ]
aws ec2 create-volume \
  --availability-zone ap-northeast-2a \
  --size 70 \
  --volume-type gp3 \
  --tag-specifications 'ResourceType=volume,Tags=[{Key=Owner,Value=ahnjaewoo},{Key=Name,Value=ML-training-data}]'

[ EBS 볼륨을 Spot Instance에 Attach 하기 ]
aws ec2 attach-volume \
  --volume-id vol-0ec4f4dbcb5323c65 \
  --instance-id i-08a494d9db63e7d3f \
  --device /dev/sdf

[ Attach한 EBS 볼륨을 마운트 하기 ]
sudo mkdir /mnt/EBS
sudo mount /dev/nvme2n1 /mnt/EBS

[ 마운트한 EBS 볼륨의 소유자 변경하기 ]
sudo chown -R ubuntu:ubuntu /mnt/EBS

[ Docker를 위한 디렉토리 생성 및 권한 변경하기 ]
mkdir -p /mnt/EBS/docker-root   <-- 요거는 EBS 뷸륨에 한 번만 만들어두면 유지됨
sudo systemctl stop docker
sudo systemctl stop containerd
sudo mv /var/lib/docker /var/lib/docker.bak
sudo ln -s /mnt/EBS/docker-root/ /var/lib/docker
sudo mv /var/lib/containerd /mnt/EBS/
sudo ln -s /mnt/EBS/containerd/ /var/lib/containerd
sudo systemctl start containerd
sudo systemctl start docker
==================================================================================================================

